# Copie para .env e preencha. Nunca commite o .env.
# Variáveis com prefixo VITE_ vão para o navegador: só coloque nelas valores públicos.

# --- Navegador (públicas) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_TURNSTILE_SITE_KEY=

# --- Servidor (segredos) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
NEON_DATABASE_URL=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
